# ==============================================================================
# CloudPulse Enterprise RAG & Ragas Evaluation Framework Configuration
# ==============================================================================

# Environment: "development", "testing", "production"
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# LLM Provider Configuration: "mock" (for zero-cost local CI/CD), "openai", or "ollama"
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=local

# OpenAI Settings (if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Ollama Settings (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Retrieval Hyperparameters
TOP_K=3
SIMILARITY_THRESHOLD=0.20
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TEMPERATURE=0.0

